#!/usr/bin/env bash
# Stop a running capture session.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/../lib/common.sh"

case "${1:-}" in
  -h|-help) echo "usage: bin/stop [session]   (omitted: the running one)" >&2; exit 0 ;;
  -?*) die_opt "$1" ;;
esac

SDIR="$(resolve_session "${1:-}")" || die "no session found (nothing running, and sessions/ is empty)"

if ! session_is_running "$SDIR"; then
  info "session $(basename "$SDIR") is not running"
  exit 0
fi

pid="$(cat "$SDIR/capture.pid")"
kill -TERM "$pid" 2>/dev/null || die "could not signal pid $pid"

for _ in $(seq 1 100); do
  kill -0 "$pid" 2>/dev/null || { ok "stopped $(basename "$SDIR")"; exit 0; }
  sleep 0.1
done

warn "pid $pid did not exit after 10s; sending SIGKILL"
kill -KILL "$pid" 2>/dev/null || true
