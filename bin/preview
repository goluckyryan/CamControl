#!/usr/bin/env bash
# Grab one still so framing and focus can be checked before a long run.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/../lib/common.sh"
source "$HELIOS_ROOT/lib/camera.sh"
need ffmpeg; need v4l2-ctl

OUT=""
while (( $# )); do
  case "$1" in
    -h|-help)
      cat <<USAGE
usage: bin/preview [-4k|-2k|-1k] [out.jpg]

One still on AUTO exposure/white balance, to check framing and focus.
Default output: preview.jpg in $HELIOS_ROOT
Unlike bin/shot this does not apply the FIX_* values — it shows what the
camera would choose for itself.

  -4k, -2k, -1k   frame size for this preview: 3840x2160, 2560x1440 or
                  1920x1080, instead of the MAX_WIDTH/MAX_HEIGHT in config.sh
                  (now ${MAX_WIDTH}x${MAX_HEIGHT}). A ceiling — the largest mode at or below
                  it is used
USAGE
      exit 0 ;;
    -4k|-4K|-2k|-2K|-1k|-1K) res_preset "$1"; shift ;;
    # A flag is not an output filename; say so instead of writing preview into
    # a file called '--help'.
    -?*) die_opt "$1" ;;
    *)   [[ -z "$OUT" ]] || die "bin/preview writes one file; got both '$OUT' and '$1'"
         OUT="$1"; shift ;;
  esac
done

[[ -n "$OUT" ]] || OUT="$HELIOS_ROOT/preview.jpg"

DEV="${DEVICE:-}"
[[ -n "$DEV" ]] || DEV="$(cam_detect || true)"
[[ -n "$DEV" ]] || die "no usable capture device found (run bin/cameras to see why)"
DEV="$(cam_stable_path "$DEV")"
CARD="$(cam_card "$DEV")"

read -r FMT W H CAPFPS < <(cam_formats "$DEV" | "$HELIOS_ROOT/tools/pick_format.py" "$MAX_WIDTH" "$MAX_HEIGHT" 1) \
  || die "could not determine a capture mode for $DEV (raise MAX_WIDTH/MAX_HEIGHT in config.sh)"
res_preset_warn "$DEV" "$CARD" "$W" "$H"
case "$FMT" in
  MJPG) IFMT=mjpeg ;;
  YUYV|YUY2) IFMT=yuyv422 ;;
  *) IFMT="$(printf '%s' "$FMT" | tr '[:upper:]' '[:lower:]')" ;;
esac

cam_apply_static "$DEV" || true

# Keep overwriting one file for a few seconds so the frame we keep is a settled
# one, not the corrupt first buffer this camera emits on open.
NFRAMES="$(awk -v w="$WARMUP_SEC" -v f="$CAPFPS" 'BEGIN{n=int(w*f); print (n<5?5:n)}')"
# -frames:v only stops when the frames arrive: if the device streams slower
# than it advertises, double the advertised budget plus ten seconds is the
# most a preview should ever take.
TMAX="$(awk -v n="$NFRAMES" -v f="$CAPFPS" 'BEGIN{printf "%.0f", n/f*2+10}')"

cam_run_ffmpeg "$CARD" ffmpeg -nostdin -loglevel error -y \
  -f v4l2 -input_format "$IFMT" -video_size "${W}x${H}" -framerate "$CAPFPS" \
  -i "$DEV" -frames:v "$NFRAMES" -update 1 -q:v "$JPEG_QUALITY" -t "$TMAX" "$OUT"

ok "wrote $OUT  ($FMT ${W}x${H}, kept the last of ${NFRAMES})"
echo "view it with: xdg-open $OUT" >&2
